# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again
loadusr -W ./manualmatic EMCO_C5_Lathe.ini

# --- ToolChanger ---

# This block will get overwritten by pcnconfig
#  ---Use external manual tool change dialog---
# loadusr -W ./hal_emcotoolchange
# net tool-change-request    =>  hal_emcotoolchange.change
# net tool-change-confirmed  <=  hal_emcotoolchange.changed
# net tool-number            =>  hal_emcotoolchange.number


# Set GPIO 47, 48, and 49 as output for tool-number
setp hm2_7i96s.0.gpio.047.is_output true
net tool-bit0    hal_emcotoolchange.bit0 => hm2_7i96s.0.gpio.047.out
setp hm2_7i96s.0.gpio.048.is_output true
net tool-bit1    hal_emcotoolchange.bit1 => hm2_7i96s.0.gpio.048.out
setp hm2_7i96s.0.gpio.049.is_output true
net tool-bit2    hal_emcotoolchange.bit2 => hm2_7i96s.0.gpio.049.out

# Set GPIO 50 as Start Strobe - Active Low
setp hm2_7i96s.0.gpio.050.is_output true
setp hm2_7i96s.0.gpio.050.invert_output true
net tool-start  hal_emcotoolchange.start => hm2_7i96s.0.gpio.050.out

# Set GPIO 44, 45, and 46 as status inputs
net tool-ready   hm2_7i96s.0.gpio.044.in => hal_emcotoolchange.ready
net tool-busy    hm2_7i96s.0.gpio.045.in => hal_emcotoolchange.busy
net tool-finish  hm2_7i96s.0.gpio.046.in => hal_emcotoolchange.finish


